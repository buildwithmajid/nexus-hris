# =============================================================================
# NEXUS HRIS — Environment Variables Template
# Salin file ini ke .env dan isi dengan nilai yang sebenarnya.
# JANGAN pernah commit file .env ke git repository!
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=Nexus HRIS API

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://nexus:nexus_dev_2026@localhost:5433/nexus_hris?schema=public

# --- JWT ---
# Buat secret kuat dengan: openssl rand -hex 32
# Access token: short-lived (15 menit)
JWT_ACCESS_SECRET=ganti_dengan_random_hex_64_karakter_minimal_dari_openssl_rand
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token: long-lived (7 hari)
JWT_REFRESH_SECRET=ganti_dengan_random_hex_lain_yang_berbeda_dari_access_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Field Encryption (AES-256-GCM) ---
# Buat dengan: openssl rand -hex 32   → hasilnya tepat 64 karakter hex (= 32 byte)
ENCRYPTION_KEY=ganti_dengan_64_karakter_hex_untuk_kunci_enkripsi_data_sensitif

# --- Hashing Pepper (untuk NIK/NPWP lookup hash) ---
# Buat dengan: openssl rand -hex 16   → hasilnya 32 karakter
ENCRYPTION_PEPPER=ganti_dengan_pepper_minimal_16_karakter

# --- CORS ---
# Pisahkan multiple origin dengan koma, tanpa spasi
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Bcrypt / Argon2 (default sudah aman, bisa override) ---
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

